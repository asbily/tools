{
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*\\.(?:html|js|css|json)$|^[^.]+$)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!.*\\.[\\w]+$).*)",
      "destination": "/index.html"
    }
  ]
}
